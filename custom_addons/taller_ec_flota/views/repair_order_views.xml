<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Campo Vehículo en el formulario de la orden de reparación -->
    <record id="view_repair_order_form_vehicle" model="ir.ui.view">
        <field name="name">repair.order.form.vehicle</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="vehicle_id"/>
            </field>
        </field>
    </record>

    <!-- Columna Vehículo en la lista de órdenes -->
    <record id="view_repair_order_tree_vehicle" model="ir.ui.view">
        <field name="name">repair.order.list.vehicle</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="vehicle_id" optional="show"/>
            </field>
        </field>
    </record>

</odoo>
