<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Grupo que ve los menús completos (Tablero, Conversaciones, Apps).
         El usuario "mecanica" NO lo tiene, así que esos menús se le ocultan.
         Se asigna al administrador para que él sí los conserve. -->
    <record id="group_taller_full_menus" model="res.groups">
        <field name="name">Taller: menús completos</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="users" eval="[(4, ref('base.user_admin')), (4, ref('base.user_root'))]"/>
    </record>
</odoo>
