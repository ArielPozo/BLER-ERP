<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_vehicle_history" model="ir.actions.report">
        <field name="name">Ficha del vehículo</field>
        <field name="model">fleet.vehicle</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bler_taller.report_vehicle_history</field>
        <field name="report_file">bler_taller.report_vehicle_history</field>
        <field name="print_report_name">'Ficha %s' % (object.license_plate or object.name)</field>
        <field name="binding_model_id" ref="fleet.model_fleet_vehicle"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Ficha con resumen e historial de trabajos del vehículo -->
    <template id="report_vehicle_history_document">
        <t t-call="web.external_layout">
            <t t-set="v" t-value="v.with_context(lang=v.driver_id.lang or v.env.lang)"/>
            <t t-set="repairs" t-value="v.repair_order_ids.filtered(lambda r: r.state != 'cancel').sorted('schedule_date', reverse=True)"/>
            <div class="page">
                <h2><i t-if="v.brand_icon_class" t-attf-class="o_car_make #{v.brand_icon_class} me-2"/><img t-elif="v.brand_id.image_128" t-att-src="image_data_uri(v.brand_id.image_128)" style="height: 1.2em; max-width: 2.4em; object-fit: contain; vertical-align: middle;" class="me-2" alt=""/>Ficha del vehículo <span t-field="v.license_plate"/></h2>
                <div class="row mb-3">
                    <div class="col-6">
                        <div class="border rounded p-2 h-100">
                            <h6 class="text-uppercase text-muted mb-1">Vehículo</h6>
                            <div><span t-field="v.brand_id"/> <span t-field="v.model_id.name"/></div>
                            <div t-if="v.model_year">Año: <span t-field="v.model_year"/></div>
                            <div t-if="v.color">Color: <span t-field="v.color"/></div>
                            <div t-if="v.vin_sn">VIN: <span t-field="v.vin_sn"/></div>
                            <div>Kilometraje: <span t-out="'{:,.0f}'.format(v.odometer).replace(',', '.')"/> <span t-field="v.odometer_unit"/></div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="border rounded p-2 h-100">
                            <h6 class="text-uppercase text-muted mb-1">Propietario</h6>
                            <div t-if="v.driver_id">
                                <strong t-field="v.driver_id.name"/>
                                <div t-if="v.driver_id.vat">RUC/CI: <span t-field="v.driver_id.vat"/></div>
                                <div t-if="v.driver_id.mobile or v.driver_id.phone">Teléfono: <span t-out="v.driver_id.mobile or v.driver_id.phone"/></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-3"><strong>Visitas:</strong> <span t-out="len(repairs)"/></div>
                    <div class="col-3"><strong>Última:</strong> <span t-field="v.last_repair_date" t-options="{'widget': 'date'}"/></div>
                    <div class="col-6">
                        <strong>Próximo mantenimiento:</strong>
                        <span t-if="v.next_service_date" t-field="v.next_service_date"/>
                        <t t-if="v.next_service_km"> / <span t-out="'{:,.0f}'.format(v.next_service_km).replace(',', '.')"/> km</t>
                        <t t-if="not v.next_service_date and not v.next_service_km">sin programar</t>
                    </div>
                </div>

                <h5 class="border-bottom pb-1">Historial de trabajos</h5>
                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Orden</th>
                            <th class="text-end">Km</th>
                            <th>Trabajos realizados</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="repairs" t-as="r">
                            <td><span t-field="r.schedule_date" t-options="{'widget': 'date'}"/></td>
                            <td><span t-field="r.name"/><br/><small class="text-muted" t-field="r.state"/></td>
                            <td class="text-end"><span t-if="r.odometer" t-out="'{:,.0f}'.format(r.odometer).replace(',', '.')"/></td>
                            <td>
                                <div t-if="r.repair_request" class="fst-italic" t-field="r.repair_request"/>
                                <div t-foreach="r.service_line_ids" t-as="s">• <span t-field="s.product_id.name"/></div>
                                <div t-foreach="r.move_ids.filtered(lambda m: m.repair_line_type == 'add')" t-as="m">
                                    • <span t-field="m.product_id.name"/> (<span t-field="m.product_uom_qty"/>)
                                </div>
                            </td>
                            <td class="text-end"><span t-field="r.amount_total"/></td>
                        </tr>
                        <tr t-if="not repairs">
                            <td colspan="5" class="text-center text-muted">Sin trabajos registrados.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <template id="report_vehicle_history">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="v">
                <t t-call="bler_taller.report_vehicle_history_document" t-lang="v.driver_id.lang"/>
            </t>
        </t>
    </template>

</odoo>
