<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_taller" model="ir.ui.view">
        <field name="name">product.template.form.taller</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="taller_duration" widget="float_time" invisible="type != 'service'"/>
            </field>
        </field>
    </record>

    <!-- Catálogo del taller: servicios (mano de obra) y repuestos (inventario)
         por separado, como en RepairOS. -->
    <record id="action_product_taller_services" model="ir.actions.act_window">
        <field name="name">Servicios</field>
        <field name="path">servicios-taller</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('type', '=', 'service')]</field>
        <field name="context" eval="{'default_type': 'service', 'default_sale_ok': True, 'default_purchase_ok': False, 'default_categ_id': ref('bler_taller.product_category_services')}"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Cree un servicio de mano de obra</p>
            <p>Por ejemplo: cambio de aceite, alineación y balanceo, ABC de frenos.
               Indique el precio y la duración estimada para la agenda.</p>
        </field>
    </record>

    <record id="action_product_taller_parts" model="ir.actions.act_window">
        <field name="name">Repuestos</field>
        <field name="path">repuestos-taller</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('type', '=', 'consu')]</field>
        <field name="context" eval="{'default_type': 'consu', 'default_is_storable': True, 'default_categ_id': ref('bler_taller.product_category_parts')}"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Cree un repuesto</p>
            <p>Los repuestos llevan control de inventario: se descuentan al
               terminar la orden de trabajo.</p>
        </field>
    </record>

</odoo>
