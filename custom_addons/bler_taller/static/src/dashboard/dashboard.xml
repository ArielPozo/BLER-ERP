<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="bler_taller.Dashboard">
        <div class="o_action o_bler_taller_dashboard h-100 overflow-auto">
            <div class="container-fluid py-3" t-if="state.data">
                <t t-set="data" t-value="state.data"/>
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                    <h2 class="mb-0">Tablero del taller</h2>
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary" t-on-click="newRepair">
                            <i class="fa fa-plus me-1"/>Nueva orden
                        </button>
                        <button class="btn btn-secondary" t-on-click="openCalendar">
                            <i class="fa fa-calendar me-1"/>Agenda
                        </button>
                        <button class="btn btn-secondary" t-on-click="load" title="Actualizar">
                            <i class="fa fa-refresh"/>
                        </button>
                    </div>
                </div>

                <!-- Órdenes por estado -->
                <div class="row g-3 mb-3">
                    <div t-foreach="data.kpis" t-as="kpi" t-key="kpi.key" class="col-6 col-md-4 col-xl">
                        <div class="card o_bler_kpi h-100" role="button"
                             t-on-click="() => this.openRecords('repair.order', kpi.label, kpi.domain)">
                            <div class="card-body d-flex align-items-center gap-3">
                                <span class="o_bler_kpi_icon"><i t-attf-class="fa {{ kpi.icon }}"/></span>
                                <div>
                                    <div class="fs-2 fw-bold lh-1" t-esc="kpi.value"/>
                                    <div class="text-muted small" t-esc="kpi.label"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Cartera (solo con permisos de facturación) -->
                <div class="row g-3 mb-3" t-if="data.billing">
                    <div t-foreach="data.billing.items" t-as="item" t-key="item.key" class="col-12 col-md-4">
                        <div class="card o_bler_kpi h-100" role="button"
                             t-on-click="() => this.openRecords('account.move', item.label, item.domain)">
                            <div class="card-body d-flex align-items-center gap-3">
                                <span class="o_bler_kpi_icon" t-att-class="{'text-danger': item.key === 'overdue' and item.value}">
                                    <i t-attf-class="fa {{ item.icon }}"/>
                                </span>
                                <div>
                                    <div class="fs-4 fw-bold lh-1" t-esc="formatAmount(item.value)"/>
                                    <div class="text-muted small" t-esc="item.label"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-3">
                    <!-- Agenda de hoy -->
                    <div class="col-12 col-xl-6">
                        <div class="card h-100">
                            <div class="card-header fw-bold"><i class="fa fa-calendar me-2"/>Agenda de hoy</div>
                            <div class="card-body p-0">
                                <div t-if="!data.agenda.length" class="p-3 text-muted">No hay trabajos agendados para hoy.</div>
                                <table t-else="" class="table table-hover mb-0">
                                    <tbody>
                                        <tr t-foreach="data.agenda" t-as="row" t-key="row.id" role="button"
                                            t-on-click="() => this.openRecord('repair.order', row.id)">
                                            <td class="fw-bold" t-esc="row.hour"/>
                                            <td>
                                                <div>
                                                    <i t-if="row.icon" t-attf-class="o_car_make {{ row.icon }} me-1"/>
                                                    <img t-elif="row.logo" t-att-src="row.logo" class="o_car_make_logo me-1" alt=""/>
                                                    <t t-esc="row.vehicle or row.name"/>
                                                </div>
                                                <div class="small text-muted" t-esc="row.partner"/>
                                            </td>
                                            <td class="small" t-esc="row.user"/>
                                            <td class="text-end"><span class="badge text-bg-secondary" t-esc="row.state_label"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Carga por mecánico -->
                    <div class="col-12 col-md-6 col-xl-3">
                        <div class="card h-100">
                            <div class="card-header fw-bold"><i class="fa fa-users me-2"/>Trabajos abiertos por mecánico</div>
                            <ul class="list-group list-group-flush">
                                <li t-if="!data.workload.length" class="list-group-item text-muted">Sin trabajos abiertos.</li>
                                <li t-foreach="data.workload" t-as="w" t-key="w.user_id or 0" role="button"
                                    class="list-group-item list-group-item-action d-flex justify-content-between"
                                    t-on-click="() => this.openWorkload(w)">
                                    <span t-esc="w.user"/>
                                    <span class="badge rounded-pill text-bg-primary" t-esc="w.count"/>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <!-- Próximos mantenimientos -->
                    <div class="col-12 col-md-6 col-xl-3">
                        <div class="card h-100">
                            <div class="card-header fw-bold"><i class="fa fa-bell me-2"/>Mantenimientos (30 días)</div>
                            <ul class="list-group list-group-flush">
                                <li t-if="!data.upcoming.length" class="list-group-item text-muted">Nada programado.</li>
                                <li t-foreach="data.upcoming" t-as="u" t-key="u.id" role="button"
                                    class="list-group-item list-group-item-action"
                                    t-on-click="() => this.openRecord('fleet.vehicle', u.id)">
                                    <div class="d-flex justify-content-between gap-2">
                                        <span>
                                            <i t-if="u.icon" t-attf-class="o_car_make {{ u.icon }} me-1"/>
                                            <img t-elif="u.logo" t-att-src="u.logo" class="o_car_make_logo me-1" alt=""/>
                                            <t t-esc="u.vehicle"/>
                                        </span>
                                        <span class="small text-nowrap" t-att-class="u.overdue ? 'text-danger fw-bold' : 'text-muted'" t-esc="u.date"/>
                                    </div>
                                    <div class="small text-muted" t-esc="u.partner"/>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
