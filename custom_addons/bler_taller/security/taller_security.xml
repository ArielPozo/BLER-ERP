<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Permiso opcional (Ajustes > Usuarios > Permisos > "Catálogo del
         taller"): crear y editar servicios y repuestos sin ser administrador
         de Inventario. Se asigna por usuario, p. ej. al mecánico. -->
    <record id="module_category_taller_catalog" model="ir.module.category">
        <field name="name">Catálogo del taller</field>
        <field name="parent_id" ref="base.module_category_inventory"/>
        <field name="sequence">50</field>
    </record>
    <record id="group_taller_catalog" model="res.groups">
        <field name="name">Crear servicios y repuestos</field>
        <field name="category_id" ref="module_category_taller_catalog"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

    <!-- Flota/usuario solo ve los vehículos donde él es el conductor. En el
         taller, quien usa Reparaciones (mecánico, recepción) debe ver y crear
         los vehículos de todos los clientes. Las reglas de distintos grupos se
         suman (OR), así que esta regla amplía la de Flota. -->
    <record id="rule_fleet_vehicle_repair_user" model="ir.rule">
        <field name="name">Taller: vehículos de todos los clientes</field>
        <field name="model_id" ref="fleet.model_fleet_vehicle"/>
        <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_fleet_vehicle_odometer_repair_user" model="ir.rule">
        <field name="name">Taller: kilometraje de todos los vehículos</field>
        <field name="model_id" ref="fleet.model_fleet_vehicle_odometer"/>
        <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
