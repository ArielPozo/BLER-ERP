<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Encabezado de los diálogos con la marca aplicada. Si el componente que
         llama a esta plantilla no es un Dialog, se usa el título original. -->
    <t t-inherit="web.Dialog.header" t-inherit-mode="extension">
        <xpath expr="//h4[hasclass('modal-title')]/t[@t-esc='props.title']" position="attributes">
            <attribute name="t-esc">brandedTitle or props.title</attribute>
        </xpath>
    </t>

    <t t-inherit="web.ErrorDialog" t-inherit-mode="extension">
        <xpath expr="//b[@t-esc='title or this.constructor.title']" position="attributes">
            <attribute name="t-esc">brandedErrorTitle</attribute>
        </xpath>
    </t>

    <t t-inherit="web.SessionExpiredDialog" t-inherit-mode="extension">
        <xpath expr="//div[@role='alert']/p" position="replace">
            <p class="text-prewrap" t-esc="brandedMessage"/>
        </xpath>
    </t>

</templates>
